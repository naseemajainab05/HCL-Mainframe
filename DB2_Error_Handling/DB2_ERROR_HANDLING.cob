
IDENTIFICATION DIVISION.
PROGRAM-ID. DB2-ERROR-HANDLING.

DATA DIVISION.
WORKING-STORAGE SECTION.

01 ACCOUNT-FOUND PIC X.
01 INPUT-BALANCE PIC X(15).
01 INPUT-DEPOSIT PIC X(15).
01 INPUT-WITHDRAWAL PIC X(15).

01 ACCOUNT-BALANCE PIC 9(9)V99.
01 TX1-AMOUNT PIC 9(9)V99.
01 TX2-AMOUNT PIC 9(9)V99.

01 TX1-NEW-BALANCE PIC 9(9)V99.
01 TX2-NEW-BALANCE PIC 9(9)V99.

01 CURRENT-VERSION PIC 9(4) VALUE 1.
01 TX1-READ-VERSION PIC 9(4).
01 TX2-READ-VERSION PIC 9(4).

01 SQLCODE-VALUE PIC S9(9) COMP-5.
01 ROW-COUNT PIC 9.
01 FINAL-BALANCE PIC Z,ZZZ,ZZZ,ZZ9.99.

PROCEDURE DIVISION.

MAIN-PROCESS.

    DISPLAY "================================".
    DISPLAY " DB2 DATABASE ERROR HANDLING".
    DISPLAY "================================".

    DISPLAY "Is the account available? (Y/N)".
    ACCEPT ACCOUNT-FOUND.

    IF ACCOUNT-FOUND = "N" OR
       ACCOUNT-FOUND = "n"

        MOVE 100 TO SQLCODE-VALUE
        PERFORM HANDLE-SQLCODE
        DISPLAY "POSTING REJECTED."
        STOP RUN

    END-IF.

    DISPLAY "Enter initial account balance:".
    ACCEPT INPUT-BALANCE.

    COMPUTE ACCOUNT-BALANCE =
        FUNCTION NUMVAL(INPUT-BALANCE).

    DISPLAY "Enter Transaction 1 deposit amount:".
    ACCEPT INPUT-DEPOSIT.

    COMPUTE TX1-AMOUNT =
        FUNCTION NUMVAL(INPUT-DEPOSIT).

    DISPLAY "Enter Transaction 2 withdrawal amount:".
    ACCEPT INPUT-WITHDRAWAL.

    COMPUTE TX2-AMOUNT =
        FUNCTION NUMVAL(INPUT-WITHDRAWAL).

    DISPLAY " ".
    DISPLAY "INITIAL ACCOUNT BALANCE: "
        ACCOUNT-BALANCE.

    DISPLAY "INITIAL VERSION: "
        CURRENT-VERSION.

    *> Both transactions read the same old version

    MOVE CURRENT-VERSION TO TX1-READ-VERSION.
    MOVE CURRENT-VERSION TO TX2-READ-VERSION.

    MOVE ACCOUNT-BALANCE TO TX1-NEW-BALANCE.
    MOVE ACCOUNT-BALANCE TO TX2-NEW-BALANCE.

    DISPLAY " ".
    DISPLAY "TRANSACTION 1 AND 2 READ VERSION: "
        CURRENT-VERSION.

    *> Transaction 1 deposits money

    COMPUTE TX1-NEW-BALANCE =
        TX1-NEW-BALANCE + TX1-AMOUNT.

    IF TX1-READ-VERSION = CURRENT-VERSION

        MOVE TX1-NEW-BALANCE TO ACCOUNT-BALANCE
        ADD 1 TO CURRENT-VERSION

        DISPLAY " "
        DISPLAY "TRANSACTION 1 COMMITTED."
        DISPLAY "UPDATED BALANCE: "
            ACCOUNT-BALANCE
        DISPLAY "NEW VERSION: "
            CURRENT-VERSION

    END-IF.

    *> Transaction 2 attempts stale update

    DISPLAY " ".
    DISPLAY "TRANSACTION 2 CHECKING VERSION...".

    IF TX2-READ-VERSION NOT = CURRENT-VERSION

        DISPLAY "STALE READ CONFLICT DETECTED."

        MOVE 0 TO ROW-COUNT
        MOVE 0 TO SQLCODE-VALUE

        DISPLAY "ZERO ROWS UPDATED."
        DISPLAY "APPLICATION ERROR: VERSION CONFLICT."

        *> Recalculate using latest balance

        DISPLAY "RECALCULATING WITH LATEST BALANCE."

        COMPUTE TX2-NEW-BALANCE =
            ACCOUNT-BALANCE - TX2-AMOUNT

        IF TX2-NEW-BALANCE < 0

            DISPLAY "INSUFFICIENT BALANCE."
            DISPLAY "TRANSACTION 2 REJECTED."

        ELSE

            *> Safe retry using current version

            MOVE CURRENT-VERSION TO TX2-READ-VERSION

            IF TX2-READ-VERSION = CURRENT-VERSION

                MOVE TX2-NEW-BALANCE
                    TO ACCOUNT-BALANCE

                ADD 1 TO CURRENT-VERSION

                DISPLAY "TRANSACTION 2 RETRIED SAFELY."
                DISPLAY "TRANSACTION 2 COMMITTED."

            END-IF

        END-IF

    ELSE

        DISPLAY "NO VERSION CONFLICT."

    END-IF.

    *> Final result

    DISPLAY " ".
    DISPLAY "================================".
    DISPLAY " FINAL TRANSACTION RESULT".
    DISPLAY "================================".

    MOVE ACCOUNT-BALANCE TO FINAL-BALANCE.

    DISPLAY "FINAL ACCOUNT BALANCE: "
        FINAL-BALANCE.

    DISPLAY "FINAL VERSION: "
        CURRENT-VERSION.

    DISPLAY "POSTING COMPLETED SAFELY."

    DISPLAY "================================".

    STOP RUN.

HANDLE-SQLCODE.

    DISPLAY " ".
    DISPLAY "DATABASE ERROR DETECTED."

    EVALUATE SQLCODE-VALUE

        WHEN 0
            DISPLAY "SUCCESSFUL EXECUTION."

        WHEN 100
            DISPLAY "SQLCODE +100: ACCOUNT NOT FOUND."
            DISPLAY "ACTION: REJECT POSTING."

        WHEN -803
            DISPLAY "SQLCODE -803: DUPLICATE KEY."
            DISPLAY "ACTION: HANDLE DUPLICATE."

        WHEN -911
            DISPLAY "SQLCODE -911: DEADLOCK/TIMEOUT."
            DISPLAY "ACTION: ROLLBACK AND RETRY."

        WHEN -913
            DISPLAY "SQLCODE -913: CONCURRENCY ERROR."
            DISPLAY "ACTION: HANDLE TRANSACTION ERROR."

        WHEN -904
            DISPLAY "SQLCODE -904: RESOURCE UNAVAILABLE."
            DISPLAY "ACTION: TEMPORARY FAILURE."

        WHEN -805
            DISPLAY "SQLCODE -805: PACKAGE NOT FOUND."
            DISPLAY "ACTION: CHECK PACKAGE CONFIGURATION."

        WHEN OTHER
            DISPLAY "UNKNOWN DATABASE ERROR."
            DISPLAY "ACTION: REJECT AND LOG ERROR."

    END-EVALUATE.
