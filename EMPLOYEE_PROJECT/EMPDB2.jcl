
//EMPDB2J JOB (ACCT),'EMPLOYEE PROGRAM',
//             CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//* EMPLOYEE MANAGEMENT SYSTEM
//* COBOL + DB2 EXECUTION
//*
//STEP01   EXEC PGM=IKJEFT01,DYNAMNBR=20
//*
//STEPLIB  DD DSN=YOUR.DB2.SDSNLOAD,DISP=SHR
//         DD DSN=YOUR.COBOL.LOADLIB,DISP=SHR
//*
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//*
//SYSTSIN  DD *
  DSN SYSTEM(DBCG)
  RUN PROGRAM(EMPDB2) PLAN(EMPPLAN)
      LIB('YOUR.COBOL.LOADLIB')
  END
/*
